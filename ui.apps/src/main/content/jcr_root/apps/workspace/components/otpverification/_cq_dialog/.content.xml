<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
    xmlns:cq="http://www.day.com/jcr/cq/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="OTP Verification Form Configuration"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <tabs
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/tabs"
                        maximized="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            
                            <!-- TAB 1: General Settings -->
                            <general
                                jcr:primaryType="nt:unstructured"
                                jcr:title="General Settings"
                                sling:resourceType="granite/ui/components/coral/foundation/container"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <formTitle
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Form Title"
                                        name="./formTitle"
                                        value="User Registration"/>
                                    <otpLength
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                        fieldLabel="OTP Length"
                                        name="./otpLength"
                                        value="6"
                                        min="4"
                                        max="8"/>
                                    <timerSeconds
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                        fieldLabel="Resend Timer (in Seconds)"
                                        name="./timerSeconds"
                                        value="60"/>
                                    <maxRetryAttempts
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                        fieldLabel="Max Allowed Retries"
                                        name="./maxRetryAttempts"
                                        value="3"/>
                                    <captchaSiteKey
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Google reCAPTCHA Site Key"
                                        name="./captchaSiteKey"/>
                                </items>
                            </general>

                            <!-- TAB 2: Dynamic Form Fields (Multifield) -->
                            <formFieldsTab
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Form Fields"
                                sling:resourceType="granite/ui/components/coral/foundation/container"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <formFields
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                        fieldDescription="Add input fields for Stage 1 form"
                                        fieldLabel="Registration Fields">
                                        <field
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container"
                                            name="./formFields">
                                            <items jcr:primaryType="nt:unstructured">
                                                <fieldLabel
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldLabel="Field Label"
                                                    name="./fieldLabel"
                                                    required="{Boolean}true"/>
                                                <fieldName
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldLabel="Field Name (attribute)"
                                                    name="./fieldName"
                                                    required="{Boolean}true"/>
                                                <fieldType
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                    fieldLabel="Field Type"
                                                    name="./fieldType">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <text
                                                            jcr:primaryType="nt:unstructured"
                                                            text="Text"
                                                            value="text"/>
                                                        <email
                                                            jcr:primaryType="nt:unstructured"
                                                            text="Email"
                                                            value="email"/>
                                                        <tel
                                                            jcr:primaryType="nt:unstructured"
                                                            text="Phone / Mobile"
                                                            value="tel"/>
                                                    </items>
                                                </fieldType>
                                                <placeholder
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldLabel="Placeholder Text"
                                                    name="./placeholder"/>
                                                <required
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                    fieldDescription="Is this field required?"
                                                    name="./required"
                                                    text="Required Field"
                                                    value="true"/>
                                            </items>
                                        </field>
                                    </formFields>
                                </items>
                            </formFieldsTab>

                            <!-- TAB 3: API Endpoints -->
                            <apiTab
                                jcr:primaryType="nt:unstructured"
                                jcr:title="API Endpoints"
                                sling:resourceType="granite/ui/components/coral/foundation/container"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <generateEndpoint
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Generate OTP Servlet URL"
                                        name="./generateEndpoint"
                                        value="/bin/workspace/generate-otp"/>
                                    <verifyEndpoint
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Verify OTP Servlet URL"
                                        name="./verifyEndpoint"
                                        value="/bin/workspace/verify-otp"/>
                                </items>
                            </apiTab>

                            <!-- TAB 4: Messages & Alerts -->
                            <messagesTab
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Messages Alerts"
                                sling:resourceType="granite/ui/components/coral/foundation/container"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <invalidOtpMsg
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Invalid OTP Message"
                                        name="./invalidOtpMsg"
                                        value="Invalid OTP! Please try again."/>
                                    <expiredOtpMsg
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Expired OTP Message"
                                        name="./expiredOtpMsg"
                                        value="OTP has expired. Please request a new one."/>
                                    <maxRetriesMsg
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Max Retries Exceeded Message"
                                        name="./maxRetriesMsg"
                                        value="Maximum verification attempts exceeded. Please restart."/>
                                    <successMsg
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Success Message"
                                        name="./successMsg"
                                        value="Verification Successful! Welcome."/>
                                </items>
                            </messagesTab>

                        </items>
                    </tabs>
                </items>
            </column>
        </items>
    </content>
</jcr:root>